{
  "name": "agenteval",
  "version": "0.1.0",
  "description": "Model and workflow evaluation harness conforming to the Agent Evaluation Protocol v0.4",
  "license": "MIT",
  "author": "57blocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/57blocks/agentic_evaluator.git"
  },
  "homepage": "https://github.com/57blocks/agentic_evaluator#readme",
  "bugs": {
    "url": "https://github.com/57blocks/agentic_evaluator/issues"
  },
  "keywords": [
    "llm",
    "evaluation",
    "agents",
    "cli",
    "benchmark"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agenteval": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:demo": "vite build",
    "demo:dev": "vite",
    "parity": "tsx scripts/parity.ts",
    "prepack": "pnpm build:demo"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ink": "^7.1.1",
    "react": "^19.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "bin": {
    "agenteval": "./bin/agenteval.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist/demo",
    "examples",
    "fixtures",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "!examples/**/runs"
  ]
}
