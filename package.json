{
  "name": "agentic-evaluator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model and workflow evaluation harness conforming to the Agent Evaluation Protocol v0.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "run": "tsx src/run.ts",
    "rescore": "tsx src/rescore.ts",
    "dashboard": "tsx src/dashboard.ts",
    "check-models": "tsx scripts/check-models.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "report": "tsx src/report-v2.ts",
    "preview": "tsx src/run.ts --suite",
    "demo": "tsx src/demo/server.ts",
    "build:demo": "vite build",
    "demo:dev": "vite"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
